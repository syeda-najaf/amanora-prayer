# ============================================================
# Amanora environment template. PLACEHOLDERS ONLY.
# Copy to .env (never commit .env). Restart Vite after editing.
# ============================================================

# --- Browser-safe (VITE_ prefix = bundled into the public app) ---
# Supabase Project URL and the PUBLISHABLE / anon key. Safe to expose; protected by RLS.
VITE_SUPABASE_URL=https://amkypwavjmkqfqjkgvpj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SMOCxiDh1ILDHo9Ng5uvzQ_3x9HypBz


# Optional public Amanora Reels JSON feed endpoint (HTTPS).
VITE_AMANORA_REELS_FEED_URL=

# ============================================================
# SERVER-ONLY secrets. NEVER prefix with VITE_. NEVER put in this file for Vercel.
# Set them with:  supabase secrets set NAME=value
#   AMANORA_SCHEDULER_SECRET   long random string for publish-scheduled
#   RAZORPAY_KEY_ID            Razorpay API key id
#   RAZORPAY_KEY_SECRET        Razorpay API key secret
#   RAZORPAY_WEBHOOK_SECRET    secret you set on the Razorpay webhook
#   ALLOWED_ORIGINS            e.g. https://your-app.vercel.app,https://yourdomain.com
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions by Supabase.)
# ============================================================
